#!/bin/bash
# ---------------------------------------------------------------------------
# Build the standalone wave-monitoring module.
#
#   ./Allwmake              build libwaveMonitoring.so (+ waveSpectra)
#   ./Allwclean             remove the build directories
#
# Requires a sourced OpenFOAM environment (v2206+). Nothing from waves2Foam
# is linked: the module only depends on OpenFOAM itself.
# ---------------------------------------------------------------------------
set -o pipefail

cd "$(dirname "$0")" || exit 1

if [ -z "${WM_PROJECT_DIR:-}" ]
then
    echo "ERROR: no OpenFOAM environment."
    echo "       source <OpenFOAM>/etc/bashrc first."
    exit 1
fi

rc=0

echo "====================================="
echo "  waveMonitoring: library"
echo "====================================="
( wmake libso ) || rc=1

if [ -d waveSpectra/Make ]
then
    echo ""
    echo "====================================="
    echo "  waveMonitoring: waveSpectra utility"
    echo "====================================="
    ( cd waveSpectra && wmake ) || rc=1
fi

if [ -d gaugesNProbes/Make ]
then
    echo ""
    echo "====================================="
    echo "  waveMonitoring: GaugesNProbes utility"
    echo "====================================="
    ( cd gaugesNProbes && wmake ) || rc=1
fi

echo ""
if [ "$rc" -ne 0 ]
then
    echo "*** waveMonitoring BUILD FAILED ***"
    exit 1
fi

echo "waveMonitoring BUILD OK"
echo "  lib : $FOAM_USER_LIBBIN/libwaveMonitoring.so"
if [ -d waveSpectra/Make ]
then
    echo "  app : $FOAM_USER_APPBIN/waveSpectra"
fi
if [ -d gaugesNProbes/Make ]
then
    echo "  app : $FOAM_USER_APPBIN/GaugesNProbes"
fi

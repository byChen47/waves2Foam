FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

xmin -1000;
xmax  1000;
ymin -1000;
ymax  1000;
zmin -100;
zmax  0;

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    boxToCell
    {
        box (0 0 0) (20.0 1.0 0.6);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);



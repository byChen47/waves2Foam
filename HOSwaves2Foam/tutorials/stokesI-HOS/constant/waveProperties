FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      waveProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// stokesI-HOS: the waves are generated by HOS-NWT and injected through the
// Grid2Grid coupling (HOS-NWT -> libGrid2Grid.so -> libwaves2FoamGrid2Grid.so).
// The original Stokes-I setting (H = 0.05 m, T = 3 s) is reproduced by the
// HOS-NWT case in the HOS-NWT/ sub-directory (amp = 0.025 m, nu = 1/3 Hz).

seaLevel        0.00;

relaxationNames (inlet outlet);

initializationName outlet;

inletCoeffs
{
    waveType    externalSource;

    Tsoft       3;

    depth       100.0;

    relaxationZone
    {
        relaxationScheme Spatial;
        relaxationShape  Rectangular;
        beachType        Empty;

        relaxType   INLET;
        startX      ( -312 0 -100 );
        endX        ( -282 0 5 );
        orientation ( 1.0 0.0 0.0 );
    }
};

outletCoeffs
{
    waveType    potentialCurrent;
    U           ( 0 0 0 );
    Tsoft       3;

    relaxationZone
    {
        relaxationScheme Spatial;
        relaxationShape  Rectangular;
        beachType        Empty;

        relaxType   OUTLET;
        startX      ( 312 0 -100 );
        endX        ( 282 0 5 );
        orientation ( 1.0 0.0 0.0 );
    }
};

externalForcing  Grid2Grid;

Grid2GridCoeffs
{
    waveType            Grid2Grid;

    Tsoft               3;

    // HOS-NWT time axis starts at 0 (including the wavemaker ramp)
    referenceTime       0;

    // OF x = -312 (inlet zone start) maps to HOS x = 20, away from the
    // wavemaker near field; OF x = -282 -> HOS x = 50
    referencePosition   ( 332 0 0 );

    referenceTheta      0;

    Grid2GridInputFileName Grid2Grid.dict;
}


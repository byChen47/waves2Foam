FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
xmin  -1000 ;
xmax   1000 ;
ymin  -1000 ;
ymax   1000 ;
zmin  -12 ;
zmax   12;
actions
(
    {
        name    c0;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     ($xmin $ymin $zmin) ($xmax $ymax $zmax);
    }
);


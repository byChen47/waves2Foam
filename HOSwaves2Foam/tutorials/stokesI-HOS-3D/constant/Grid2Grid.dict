#-------------------------------------------------------------------------- #
#
#                  Grid2Grid Dictionary Input File
#
#-------------------------------------------------------------------------- #

// Select the HOS model that produced the mode file
Grid2Grid       HOSNWT;

writeVTK                false;
writeWaveProbe          true;
writeVelocityProbe      true;
writePressureProbe      true;

zMesh
{
    // Cover the relaxation-zone water column (-100 m) plus air above
    zMin           -100.0;
    zMax            1.0;

    nZMin           33;
    nZMax           10;

    zMeshType         uniform;
    zMinRatio       3.0;
    zMaxRatio       3.0;
}

HOSOcean
{
    type            Ocean;
    filePath        constant/modes_HOS_Ocean.dat;
    extraInterpolationNumber 1;
    interpolationOrder  3;
    $zMesh
    writeLog        TRUE;
    cutAtElevation  FALSE;
}

HOSNWT
{
    type            NWT;

    // Mode file produced by the HOS-NWT case in HOS-NWT/
    filePath        constant/modes_HOS_SWENSE.dat;

    procedure       velocity;
    addedMode       false;

    extraInterpolationNumber 2;
    interpolationOrder  3;
    cutAtElevation      true;

    $zMesh

    writeLog        TRUE;
}

simulation
{
    startTime       0.0;
    endTime		    29.99;
    dt              0.01;
}

waveProbe
{
    outputFile   waveElevation.dat;

    probeList
    {
        waveProbes1
        {
            position    ( 25.0 5.0 );
        }
        waveProbes2
        {
            position    ( 35.0 10.0 );
        }
        waveProbes3
        {
            position    ( 45.0 15.0 );
        }
    }
}

velocityProbe
{
    outputFile  velocityProbe.dat;

    probeList
    {
        velocityProbes1
        {
            position    (25.0  10.0  -10.0);
        }
    }
}

pressureProbe
{
    outputFile  pressureProbe.dat;

    probeList
    {
        pressureProbes1
        {
            position    (35.0  5.0  -10.0);
        }
    }
}

/* ------------------------------------------------------------------------- *\
#                                END OF FILE
\* ------------------------------------------------------------------------- */

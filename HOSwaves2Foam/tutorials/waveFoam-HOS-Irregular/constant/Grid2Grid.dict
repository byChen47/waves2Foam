// Select the HOS model that produced the mode file
//Grid2Grid       HOSOcean;
Grid2Grid       HOSNWT;

writeVTK                false;

writeWaveProbe          true;
writeVelocityProbe      true;
writePressureProbe      true;

zMesh
{
    zMin           -0.4;
    zMax            0.1;

    nZMin           21;
    nZMax           21;

    //type            uniform;
    zMeshType         uniform;
    //   uniform   : uniform mesh
    //   sine      : sine mesh

    zMinRatio       3.0;        // if type = meshRatio
    zMaxRatio       3.0;
}

HOSOcean
{
    type            Ocean;

    filePath        constant/modes_HOS_Ocean.dat;
    extraInterpolationNumber 1;

    interpolationOrder  3;      // 1 : Linear, 2: Quadratic, 3 : Cubic (default = 3)

    $zMesh

    writeLog        TRUE;

    cutAtElevation  FALSE;
}

HOSNWT
{
    type            NWT;

    // Mode file produced by the irregular-wave HOS-NWT case
    // (../HOS-NWT-Irregular, JONSWAP spectrum)
    filePath        constant/modes_HOS_SWENSE.dat;

    procedure       velocity; // 1.velocity 2.potential

    extraInterpolationNumber 2;

    interpolationOrder  3;      // 1 : Linear, 2: Quadratic, 3 : Cubic

    $zMesh

    writeLog        TRUE;
}

simulation
{
    startTime       0.0;
    endTime		    12.0;
    dt              0.01;
}

vtkMesh
{
    airMesh         true;

    xMin            0.0;
    xMax            18.0;

    yMin            0.0;
    yMax            0.1;

    nX              180;
    nY              2;

    $zMesh
}

waveProbe
{
    outputFile   waveElevation.dat;

    probeList
    {
        waveProbes1
        {
            position    ( 2.0 0.0 );
        }
        waveProbes2
        {
            position    ( 3.0 0.0 );
        }
        waveProbes3
        {
            position    ( 4.0 0.0 );
        }
    }
}

velocityProbe
{
    outputFile  velocityProbe.dat;

    probeList
    {
        velocityProbes1
        {
            position    (2.0  0.0  -0.2);
        }
    }
}

pressureProbe
{
    outputFile  pressureProbe.dat;

    probeList
    {
        pressureProbes1
        {
            position    (2.0  0.0  -0.2);
        }
    }
}


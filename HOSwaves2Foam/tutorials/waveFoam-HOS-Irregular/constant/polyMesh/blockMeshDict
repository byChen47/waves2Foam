// Small 2D flume: 18 m long, 0.5 m high (0.4 m water + 0.1 m air),
// single cell in y centred on y = 0 (Grid2Grid with nY = 1 only supports
// the HOS tank centreline y = 0).  Vertical direction is z.

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

vertices
(
    (  0 -0.05 -0.4 )
    ( 18 -0.05 -0.4 )
    ( 18  0.05 -0.4 )
    (  0  0.05 -0.4 )

    (  0 -0.05  0.1 )
    ( 18 -0.05  0.1 )
    ( 18  0.05  0.1 )
    (  0  0.05  0.1 )
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ( 180 1 30 ) simpleGrading (1 1 1)
);

edges
(
);

patches
(
    patch inlet
    (
        (0 3 7 4)
    )
    wall bottom
    (
        (0 1 2 3)
    )
    patch outlet
    (
        (1 5 6 2)
    )
    patch atmosphere
    (
        (4 7 6 5)
    )
    empty frontBack
    (
        (0 4 5 1)
        (3 7 6 2)
    )
);

mergePatchPairs
(
);


#!/bin/bash

rc=0

# Build one library and remember whether anything failed
build_lib ()
{
    ( cd "$1" && wmake libso ) || { echo "*** FAILED: library $1"; rc=1; }
}

if [ ! -f "./../bin/bashrc" ]
then
    cp ../bin/bashrc.org ../bin/bashrc
    chmod a+x ./../bin/bashrc
fi

. ../bin/bashrc

# Take care of the differences in the options, which arose between OF21 and OF22.
rm -f $WAVES_SRC/Make/options
dirList=`ls -d waves2Foam*`

if [ $FOAMEXTENDPROJECT -eq "1" ]
then
    for i in $dirList
    do
        ln -s -f $WAVES_SRC/$i/Make/options.210 $WAVES_SRC/$i/Make/options
    done
elif [ $OFPLUSBRANCH -eq "1" ]
then
    for i in $dirList
    do
        ln -s -f $WAVES_SRC/$i/Make/options.220 $WAVES_SRC/$i/Make/options
    done
else
    if [ "$WM_PROJECT_VERSION_NUMBER" -lt "220" ]
    then
        for i in $dirList
        do
            ln -s -f $WAVES_SRC/$i/Make/options.210 $WAVES_SRC/$i/Make/options
        done
    else
        for i in $dirList
        do
            ln -s -f $WAVES_SRC/$i/Make/options.220 $WAVES_SRC/$i/Make/options
        done
    fi
fi

# Compile the library
build_lib waves2Foam

if [ $OFPLUSBRANCH -eq "1" ]
then
    if [ "$WM_PROJECT_VERSION_NUMBER" -gt "1806" ]
    then
        build_lib waves2FoamGABC
    fi
fi

build_lib waves2FoamProcessing

# Currently, only compile waves2FoamSampling for all Openfoam versions except
# for OpenFOAM-4.0
if [ $FOAMEXTENDPROJECT -eq "1" ]
then
    build_lib waves2FoamSampling
elif [ $OFPLUSBRANCH -eq "1" ]
then
    if [ "$WM_PROJECT_VERSION_NUMBER" -lt "1706" ]
    then
        build_lib waves2FoamSampling
    elif [ "$WM_PROJECT_VERSION_NUMBER" -lt "2206" ]
    then
        build_lib waves2FoamSampling1712
    elif [ "$WM_PROJECT_VERSION_NUMBER" -lt "2406" ]

    then
        build_lib waves2FoamSampling2206
    elif [ "$WM_PROJECT_VERSION_NUMBER" -lt "2606" ]

    then
        build_lib waves2FoamSampling2406
    else
        build_lib waves2FoamSampling2606
    fi

    else
    if [ "$WM_PROJECT_VERSION_NUMBER" -lt "400" ]
    then
        build_lib waves2FoamSampling
    fi
fi

build_lib waves2FoamPorosity

if [ "$WM_PROJECT_VERSION_NUMBER" -eq "1606" ]
then
    build_lib waves2FoamMooring
fi

exit $rc
